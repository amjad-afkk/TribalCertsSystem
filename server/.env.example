# Google Gemini API Key — get yours at https://aistudio.google.com/apikey
# In Render: Go to Service Dashboard -> Environment -> Add GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Demo mode toggle (true/false)
DEMO_MODE=true

# Port (Render sets this automatically at runtime)
# PORT=4000

# CORS Allowed Origins (comma-separated). Set if running client on a separate domain.
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
