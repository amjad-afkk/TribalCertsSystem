{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API service for MoTA Scholarship Management System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/db', { recursive: true }); fs.copyFileSync('src/db/schema.sql', 'dist/db/schema.sql'); })\"",
    "start": "node --experimental-sqlite dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
